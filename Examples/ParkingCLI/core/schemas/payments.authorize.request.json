{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/parking/schemas/payments.authorize.request.json",
  "title": "payments.authorize request",
  "description": "Generated from examples/dto-parking/Parking/Codecs.lean.",
  "type": "object",
  "additionalProperties": false,
  "required": ["amount", "currency", "token"],
  "properties": {
    "amount": {
      "description": "Minor units (cents), as a decimal string.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-tribrach": { "minimum": 1, "maximum": 20000 }
    },
    "currency": { "enum": ["CAD", "USD"] },
    "token": { "type": "string", "minLength": 1, "maxLength": 64 }
  }
}
