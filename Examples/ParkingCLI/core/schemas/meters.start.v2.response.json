{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/parking/schemas/meters.start.v2.response.json",
  "title": "meters.start v2 response",
  "description": "Generated from examples/dto-parking/Parking/Codecs.lean.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "sessionId", "startsAt", "expiresAt", "charged"],
      "properties": {
        "charged": {
          "description": "Minor units (cents), as a decimal string.",
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "x-tribrach": { "minimum": 1, "maximum": 20000 }
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        },
        "result": { "const": "started" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "startsAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "sessionId", "position"],
      "properties": {
        "position": { "type": "integer", "minimum": 1, "format": "int64" },
        "result": { "const": "queued" },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "reason"],
      "properties": { "reason": { "type": "string", "minLength": 1 }, "result": { "const": "rejected" } }
    }
  ]
}
